# Django
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=replace-with-a-long-random-production-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend,.onrender.com,api.tredro.online
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://tredro-dashboard.vercel.app,capacitor://localhost,https://localhost
DJANGO_CSRF_TRUSTED_ORIGINS=https://api.tredro.online

# PostgreSQL
DATABASE_NAME=tredro
DATABASE_USER=tredro
DATABASE_PASSWORD=tredro
DATABASE_HOST=postgres
DATABASE_PORT=5432

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Gunicorn (production)
GUNICORN_BIND=0.0.0.0:8000
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=60
CELERY_WORKER_CONCURRENCY=2

# Public API hostname used by Caddy
API_DOMAIN=api.tredro.online

# PgAdmin
PGADMIN_EMAIL=admin@tredro.com
PGADMIN_PASSWORD=replace-with-a-strong-local-password
