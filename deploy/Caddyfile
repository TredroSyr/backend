{$API_DOMAIN:api.tredro.online} {
	encode zstd gzip

	header {
		-X-Powered-By
		-Server
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
	}

	handle_path /static/* {
		root * /srv/static
		file_server
	}

	handle_path /media/* {
		root * /srv/media
		file_server
	}

	handle {
		reverse_proxy backend:8000
	}

	log {
		output stdout
		format console
	}
}
